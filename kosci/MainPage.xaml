<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="kosci.MainPage"
             BackgroundColor="#ED27C121">

    <ScrollView>
        <VerticalStackLayout HorizontalOptions="Center"
                             Padding="30,0"
                             Spacing="25">

            <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                <ImageButton Source="kosc0.png"
                             x:Name="imagebutton1"
                             Clicked="ImageButton_Clicked"
                             MaximumHeightRequest="110"/>
                <ImageButton Source="kosc0.png"
                             x:Name="imagebutton2"
                             Clicked="ImageButton_Clicked"
                             MaximumHeightRequest="110"/>
                <ImageButton Source="kosc0.png"
                             x:Name="imagebutton3"
                             Clicked="ImageButton_Clicked"
                             MaximumHeightRequest="110"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                <ImageButton Source="kosc0.png"
                             x:Name="imagebutton4"
                             Clicked="ImageButton_Clicked"
                             MaximumHeightRequest="110"/>
                <ImageButton Source="kosc0.png"
                             x:Name="imagebutton5"
                             Clicked="ImageButton_Clicked"
                             MaximumHeightRequest="110"/>
            </HorizontalStackLayout>

            <Button Text="RZUT"
                    BackgroundColor="#ED275021"
                    Margin="10"
                    TextColor="White"
                    HorizontalOptions="Center"
                    Clicked="Button_Losuj_Clicked"/>

            <Label x:Name="wyniklabel"
                   TextColor="black"
                   Text="0"
                   FontSize="40"
                   HorizontalOptions="Center"/> 
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>